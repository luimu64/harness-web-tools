{
  "name": "harness-web-tools",
  "version": "2.0.0",
  "description": "Keyless web search and static page extraction for DeepSeek Harness",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dsh": {
      "types": "./src/adapters/dsh.ts",
      "import": "./dist/adapters/dsh.js",
      "default": "./dist/adapters/dsh.js"
    }
  },
  "files": [
    "dist",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/adapters/dsh.ts --outdir dist --target node",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "web-search",
    "web-extract",
    "duckduckgo",
    "content-extraction"
  ],
  "author": "Leimu Raittinen",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.2.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  }
}
